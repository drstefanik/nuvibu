APP_NAME=Nuvibù Studio
APP_ENV=development
RUNTIME_ROLE=web
APP_BASE_URL=http://localhost:8000
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=
ADMIN_PASSWORD=
DATABASE_URL=sqlite:///./nuvibu.db
STORAGE_ROOT=./storage
STORAGE_BACKEND=local
PROVIDER_MODE=mock

# ElevenLabs Music
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_48000_192

# Google Veo. Vertex AI with ADC is the production default.
VEO_BACKEND=vertex
VEO_MODEL=veo-3.1-generate-001
GOOGLE_CLOUD_PROJECT=nuvibu
GOOGLE_CLOUD_LOCATION=us-central1
VEO_OUTPUT_GCS_URI=gs://your-bucket/veo-output/
# Optional only for local Vertex development. Cloud Run uses its service identity (ADC).
GOOGLE_APPLICATION_CREDENTIALS=

# Required only when VEO_BACKEND=gemini.
GEMINI_API_KEY=

# Production worker dispatch
CLOUD_RUN_JOB_NAME=
CLOUD_RUN_JOB_LOCATION=us-central1
CLOUD_RUN_DISPATCH_RETRY_SECONDS=180
JOB_STALE_AFTER_SECONDS=3900

# YouTube OAuth
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube-client-secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube-token.json
YOUTUBE_CATEGORY_ID=10
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_CHANNEL_MADE_FOR_KIDS=true

# Production guardrails
MAX_EPISODE_SECONDS=180
MAX_MUSIC_VARIANTS=1
MAX_SCENE_RETRIES=0
MAX_ESTIMATED_COST_USD_PER_EPISODE=40
MAX_DAILY_ESTIMATED_COST_USD=40
